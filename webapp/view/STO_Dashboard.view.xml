<mvc:View controllerName="Z_STO_Report_GC.controller.STO_Dashboard" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
	xmlns:layout="sap.ui.layout" xmlns:chart="sap.suite.ui.commons" xmlns:viz="sap.viz.ui5.controls" xmlns:viz.data="sap.viz.ui5.data"
	xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds" xmlns:table="sap.ui.table" displayBlock="true">
	<App>
		<Page showHeader="false" enableScrolling="true" class="stoPage">
			<content>
				<VBox class="stoHeader sapUiResponsiveContentPadding">
					<Title text="STO Dashboard" level="H1" class="stoTitle"/>
					<Text text="Stock Transfer Orders: PO › PGI › GRN › MIRO" class="stoSubtitle"/>
					<HBox wrap="Wrap" alignItems="End" class="stoFilters filterSurface">
						<VBox class="plantFilter">
							<Label text="Supplying Plant" required="true" labelFor="plantInput"/>
							<MultiInput id="plantInput" placeholder="Enter plant codes and press Enter" showValueHelp="false" tokenUpdate="onPlantTokenUpdate"
								value="{view>/plantDraft}" submit="onPlantSubmit"/>
						</VBox>
						<VBox class="yearFilter">
							<Label text="Posting Year" labelFor="yearSelect"/>
							<Select id="yearSelect" width="100%" selectedKey="{view>/year}" items="{view>/years}" change="onYearChange">
								<core:Item key="{view>key}" text="{view>text}"/>
							</Select>
						</VBox>
						<VBox class="filterActions">
							<Label text="Actions"/>
							<HBox class="filterActionButtons" alignItems="Center">
								<Button text="Go" type="Emphasized" press="onGo"/>
								<Button text="Clear" type="Transparent" press="onClear"/>
							</HBox>
						</VBox>
					</HBox>
				</VBox>
				<VBox class="stoBody sapUiResponsiveContentPadding">
					<layout:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" class="kpiGrid">
						<VBox class="kpiCard kpiBlue">
							<HBox class="kpiCardTop" alignItems="Center" justifyContent="SpaceBetween"><Title text="STO Purchase Orders" level="H4"/><core:Icon src="sap-icon://cart" class="kpiIcon" tooltip="Purchase orders"/></HBox>
							<Text text="Aggregated from service" class="kpiDescription"/>
							<ObjectNumber number="{view>/kpi/po}" class="kpiNumber"/>
							<Text text="{view>/kpi/plantCaption}" class="kpiFootnote"/>
						</VBox>
						<VBox class="kpiCard kpiCyan">
							<HBox class="kpiCardTop" alignItems="Center" justifyContent="SpaceBetween"><Title text="PGI Documents" level="H4"/><core:Icon src="sap-icon://shipping-status" class="kpiIcon" tooltip="Goods issue documents"/></HBox>
							<Text text="Goods issue at supplying plant" class="kpiDescription"/>
							<ObjectNumber number="{view>/kpi/pgiDocs}" class="kpiNumber"/>
						</VBox>
						<VBox class="kpiCard kpiGreen">
							<HBox class="kpiCardTop" alignItems="Center" justifyContent="SpaceBetween"><Title text="GRN Documents" level="H4"/><core:Icon src="sap-icon://inbox" class="kpiIcon" tooltip="Goods receipt documents"/></HBox>
							<Text text="Goods receipt at receiving plant" class="kpiDescription"/>
							<ObjectNumber number="{view>/kpi/grnDocs}" class="kpiNumber"/>
						</VBox>
						<VBox class="kpiCard kpiOrange">
							<HBox class="kpiCardTop" alignItems="Center" justifyContent="SpaceBetween"><Title text="MIRO Documents" level="H4"/><core:Icon src="sap-icon://document-text" class="kpiIcon" tooltip="Invoice receipt documents"/></HBox>
							<Text text="Invoice receipt" class="kpiDescription"/>
							<ObjectNumber number="{view>/kpi/miroDocs}" class="kpiNumber"/>
						</VBox>
					</layout:Grid>
					<VBox visible="{view>/promptVisible}" class="startCard">
						<core:Icon src="sap-icon://filter" size="1.5rem" class="startIcon"/>
						<VBox><Title text="Choose a supplying plant to begin" level="H3"/><Text text="Add one or more plant codes, then select Go. Plant overview and monthly trends will load in separate sections."
							class="mutedText"/></VBox>
					</VBox>
					<HBox width="100%" justifyContent="Center" alignItems="Center" visible="{view>/plantBusy}" class="sectionLoader"><BusyIndicator size="1.75rem"/><Text text="Loading plant overview…" class="loaderText"/></HBox>
					<MessageStrip text="{view>/plantError}" type="Error" showIcon="true" visible="{= !!${view>/plantError} }" class="sapUiSmallMarginTop"/>
					<VBox visible="{view>/plantVisible}" class="sectionBlock">
						<HBox class="sectionHeader" alignItems="Center">
							<core:Icon src="sap-icon://factory" class="sectionHeaderIcon"/>
							<VBox class="sectionHeading"><Title text="{view>/plantTitle}" level="H2" class="sectionTitle"/><Text text="All postings for the selected supplying plants, across all years" class="sectionSubtitle"/></VBox>
						</HBox>
						<layout:Grid defaultSpan="XL6 L6 M12 S12" hSpacing="1" vSpacing="1" class="pairedChartGrid">
							<VBox class="pairedChartPane"><Title text="Receiving Plant-wise STO Records" level="H3"/><Text text="Purchase orders by receiving plant" class="mutedText"/>
								<chart:ChartContainer showFullScreen="true" showPersonalization="false" showZoom="true" showLegendButton="false" showSelectionDetails="true"
									class="chartTools">
									<chart:content>
										<chart:ChartContainerContent title="STO records by receiving plant" icon="sap-icon://bar-chart">
											<chart:content>
												<viz:VizFrame id="plantPoChart" vizType="bar" width="100%" height="18.5rem" uiConfig="{applicationSet:'fiori'}"
													renderComplete="onChartRenderComplete" vizProperties="{title:{visible:false},plotArea:{dataLabel:{visible:true}},legend:{visible:false}}">
													<viz:dataset>
														<viz.data:FlattenedDataset data="{plant>/byPlant}">
															<viz.data:dimensions><viz.data:DimensionDefinition name="Receiving Plant" value="{plant>werks}"/></viz.data:dimensions>
															<viz.data:measures><viz.data:MeasureDefinition name="No. of PO" value="{plant>po}"/></viz.data:measures>
														</viz.data:FlattenedDataset>
													</viz:dataset>
													<viz:feeds><viz.feeds:FeedItem uid="valueAxis" type="Measure" values="No. of PO"/><viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Receiving Plant"/></viz:feeds>
												</viz:VizFrame>
											</chart:content>
										</chart:ChartContainerContent>
									</chart:content>
								</chart:ChartContainer>
							</VBox>
							<VBox class="pairedChartPane"><Title text="Receiving Plant-wise PGI Value" level="H3"/><Text text="PGI value in INR Lakh" class="mutedText"/>
								<chart:ChartContainer showFullScreen="true" showPersonalization="false" showZoom="true" showLegend="true" showLegendButton="false"
									showSelectionDetails="true" class="chartTools">
									<chart:content>
										<chart:ChartContainerContent title="PGI value by receiving plant" icon="sap-icon://pie-chart">
											<chart:content>
												<viz:VizFrame id="plantValueChart" vizType="donut" width="100%" height="18.5rem" uiConfig="{applicationSet:'fiori'}"
													renderComplete="onChartRenderComplete"
													vizProperties="{title:{visible:false},plotArea:{dataLabel:{visible:true,type:'percentage'}},legend:{visible:true},legendGroup:{layout:{position:'right'}}}">
													<viz:dataset>
														<viz.data:FlattenedDataset data="{plant>/byValue}">
															<viz.data:dimensions><viz.data:DimensionDefinition name="Receiving Plant · PGI Value (INR Lakh)" value="{plant>legendLabel}"/></viz.data:dimensions>
															<viz.data:measures><viz.data:MeasureDefinition name="PGI Value (INR Lakh)" value="{plant>value}"/></viz.data:measures>
														</viz.data:FlattenedDataset>
													</viz:dataset>
													<viz:feeds><viz.feeds:FeedItem uid="size" type="Measure" values="PGI Value (INR Lakh)"/><viz.feeds:FeedItem uid="color" type="Dimension" values="Receiving Plant · PGI Value (INR Lakh)"/></viz:feeds>
												</viz:VizFrame>
											</chart:content>
										</chart:ChartContainerContent>
									</chart:content>
								</chart:ChartContainer>
							</VBox>
						</layout:Grid>
					</VBox>
					<HBox width="100%" justifyContent="Center" alignItems="Center" visible="{view>/monthlyBusy}" class="sectionLoader"><BusyIndicator size="1.75rem"/><Text text="Loading monthly analysis…" class="loaderText"/></HBox>
					<MessageStrip text="{view>/monthlyError}" type="Error" showIcon="true" visible="{= !!${view>/monthlyError} }" class="sapUiSmallMarginTop"/>
					<VBox visible="{view>/monthlyVisible}" class="sectionBlock">
						<HBox class="sectionHeader" alignItems="Center">
							<core:Icon src="sap-icon://calendar" class="sectionHeaderIcon"/>
							<VBox class="sectionHeading"><Title text="{view>/monthlyTitle}" level="H2" class="sectionTitle"/><Text text="Posting year selection applies to this section only" class="sectionSubtitle"/></VBox>
						</HBox>
						<layout:Grid defaultSpan="XL12 L12 M12 S12" hSpacing="0" vSpacing="1" class="pairedChartGrid">
							<VBox class="pairedChartPane">
								<HBox class="monthlyChartHeading" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
									<VBox class="monthlyChartHeadingCopy"><Title text="Monthly STO Trend Analysis" level="H3"/><Text text="PGI and GRN records by posting month" class="mutedText"/></VBox>
									<OverflowToolbar width="auto" class="chartMetricToolbar monthlyTrendTotals">
										<ObjectNumber number="{monthly>/totals/pgi}" unit="PGI total" class="chartTotal trendPgiTotal"/>
										<ObjectNumber number="{monthly>/totals/grn}" unit="GRN total" class="chartTotal trendGrnTotal"/>
									</OverflowToolbar>
								</HBox>
								<chart:ChartContainer showFullScreen="true" showPersonalization="false" showZoom="true" showLegend="false" showLegendButton="false"
									showSelectionDetails="true" class="chartTools">
									<chart:content>
										<chart:ChartContainerContent title="Monthly PGI and GRN trend" icon="sap-icon://line-chart">
											<chart:content>
												<viz:VizFrame id="monthlyTrendChart" vizType="column" width="100%" height="18.5rem" uiConfig="{applicationSet:'fiori'}"
													renderComplete="onChartRenderComplete"
													vizProperties="{title:{visible:false},plotArea:{dataLabel:{visible:true},colorPalette:['#0a6ed1','#e9730c']},legend:{visible:false}}">
													<viz:dataset>
														<viz.data:FlattenedDataset data="{monthly>/byMonth}">
															<viz.data:dimensions><viz.data:DimensionDefinition name="Month" value="{monthly>month}"/></viz.data:dimensions>
															<viz.data:measures><viz.data:MeasureDefinition name="PGI records" value="{monthly>pgi}"/><viz.data:MeasureDefinition name="GRN records" value="{monthly>grn}"/></viz.data:measures>
														</viz.data:FlattenedDataset>
													</viz:dataset>
													<viz:feeds><viz.feeds:FeedItem uid="valueAxis" type="Measure" values="PGI records,GRN records"/><viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Month"/></viz:feeds>
												</viz:VizFrame>
											</chart:content>
										</chart:ChartContainerContent>
									</chart:content>
								</chart:ChartContainer>
								<HBox width="100%" class="chartLegend" justifyContent="Center" alignItems="Center">
									<HBox class="chartLegendItem" alignItems="Center"><Text text=" " class="chartLegendSwatch pgiLegendSwatch"/><Text text="PGI records"/></HBox>
									<HBox class="chartLegendItem" alignItems="Center"><Text text=" " class="chartLegendSwatch grnLegendSwatch"/><Text text="GRN records"/></HBox>
								</HBox>
							</VBox>
							<VBox class="pairedChartPane">
								<HBox class="monthlyChartHeading" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
									<VBox class="monthlyChartHeadingCopy"><Title text="Receiving Plant-wise PGI vs GRN" level="H3"/><Text text="Document counts by receiving plant" class="mutedText"/></VBox>
									<OverflowToolbar width="auto" class="chartMetricToolbar monthlyPlantTotals">
										<ObjectNumber number="{monthly>/totals/pgi}" unit="PGI total" class="chartTotal plantPgiTotal"/>
										<ObjectNumber number="{monthly>/totals/grn}" unit="GRN total" class="chartTotal plantGrnTotal"/>
									</OverflowToolbar>
								</HBox>
								<chart:ChartContainer showFullScreen="true" showPersonalization="false" showZoom="true" showLegend="false" showLegendButton="false"
									showSelectionDetails="true" class="chartTools">
									<chart:content>
										<chart:ChartContainerContent title="PGI and GRN by receiving plant" icon="sap-icon://bar-chart">
											<chart:content>
												<viz:VizFrame id="monthlyPlantChart" vizType="column" width="100%" height="18.5rem" uiConfig="{applicationSet:'fiori'}"
													renderComplete="onChartRenderComplete"
													vizProperties="{title:{visible:false},plotArea:{dataLabel:{visible:true},colorPalette:['#8b5cf6','#00a6a6']},legend:{visible:false}}">
													<viz:dataset>
														<viz.data:FlattenedDataset data="{monthly>/byMonthlyPlant}">
															<viz.data:dimensions><viz.data:DimensionDefinition name="Receiving Plant" value="{monthly>werks}"/></viz.data:dimensions>
															<viz.data:measures><viz.data:MeasureDefinition name="PGI records" value="{monthly>pgi}"/><viz.data:MeasureDefinition name="GRN records" value="{monthly>grn}"/></viz.data:measures>
														</viz.data:FlattenedDataset>
													</viz:dataset>
													<viz:feeds><viz.feeds:FeedItem uid="valueAxis" type="Measure" values="PGI records,GRN records"/><viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Receiving Plant"/></viz:feeds>
												</viz:VizFrame>
											</chart:content>
										</chart:ChartContainerContent>
									</chart:content>
								</chart:ChartContainer>
								<HBox width="100%" class="chartLegend" justifyContent="Center" alignItems="Center">
									<HBox class="chartLegendItem" alignItems="Center"><Text text=" " class="chartLegendSwatch monthlyPgiLegendSwatch"/><Text text="PGI records"/></HBox>
									<HBox class="chartLegendItem" alignItems="Center"><Text text=" " class="chartLegendSwatch monthlyGrnLegendSwatch"/><Text text="GRN records"/></HBox>
								</HBox>
							</VBox>
						</layout:Grid>
					</VBox>
					<layout:Grid defaultSpan="XL12 L12 M12 S12" hSpacing="1" vSpacing="1" class="tableSplitGrid" visible="{view>/summaryVisible}">
						<VBox class="summaryCard tablePanel">
							<OverflowToolbar><Title text="Plant Summary" level="H3"/><ToolbarSpacer/><SearchField width="10rem" placeholder="Search plants" liveChange="onPlantSearch"/><Button text="Export" icon="sap-icon://excel-attachment" press="onExportPlant"/></OverflowToolbar>
							<HBox class="tableContextBar" alignItems="Center"><core:Icon src="sap-icon://factory"/><Text text="{= 'Supplying plant(s): ' + ${view>/plantContext} + ' · Monthly section year: ' + ${view>/year} }"/></HBox>
							<table:Table id="plantTable" width="100%" rows="{plant>/table}" selectionMode="None" visibleRowCountMode="Auto" minAutoRowCount="8"
								enableColumnReordering="true" showNoData="true">
								<table:columns>
									<table:Column sortProperty="werks" filterProperty="werks"><Label text="Receiving Plant"/>
										<table:template><Text text="{plant>werks}"/></table:template>
									</table:Column>
									<table:Column sortProperty="po" filterProperty="po" hAlign="End"><Label text="STO POs"/>
										<table:template><ObjectNumber number="{plant>po}"/></table:template>
									</table:Column>
									<table:Column sortProperty="value" filterProperty="value" hAlign="End"><Label text="PGI Value (INR Lakh)"/>
										<table:template><ObjectNumber number="{plant>value}"/></table:template>
									</table:Column>
								</table:columns>
							</table:Table>
							<layoutData><layout:GridData span="XL5 L5 M5 S12"/></layoutData>
						</VBox>
						<VBox class="summaryCard tablePanel">
							<OverflowToolbar><Title text="Monthly PGI / GRN Summary" level="H3"/><ToolbarSpacer/><SearchField width="10rem" placeholder="Search plants or months" liveChange="onMonthlySearch"/><Button text="Export" icon="sap-icon://excel-attachment" press="onExportMonthly"/></OverflowToolbar>
							<HBox class="tableContextBar" alignItems="Center"><core:Icon src="sap-icon://factory"/><Text text="{= 'Supplying plant(s): ' + ${view>/plantContext} + ' · Monthly section year: ' + ${view>/year} }"/></HBox>
							<table:Table id="monthlyTable" width="100%" rows="{monthly>/table}" selectionMode="None" visibleRowCountMode="Auto" minAutoRowCount="8"
								enableColumnReordering="true" showNoData="true">
								<table:columns>
									<table:Column sortProperty="werks" filterProperty="werks"><Label text="Receiving Plant"/>
										<table:template><Text text="{monthly>werks}"/></table:template>
									</table:Column>
									<table:Column sortProperty="month" filterProperty="month"><Label text="Month"/>
										<table:template><Text text="{monthly>month}"/></table:template>
									</table:Column>
									<table:Column sortProperty="pgi" filterProperty="pgi" hAlign="End"><Label text="PGI Records"/>
										<table:template><ObjectNumber number="{monthly>pgi}"/></table:template>
									</table:Column>
									<table:Column sortProperty="grn" filterProperty="grn" hAlign="End"><Label text="GRN Records"/>
										<table:template><ObjectNumber number="{monthly>grn}"/></table:template>
									</table:Column>
								</table:columns>
							</table:Table>
							<layoutData><layout:GridData span="XL7 L7 M7 S12"/></layoutData>
						</VBox>
					</layout:Grid>
					<VBox visible="{view>/emptyVisible}" class="emptyState"><Title text="No data" level="H2"/><Text text="Choose one or more supplying plants, then select Go." class="mutedText"/></VBox>
				</VBox>
			</content>
		</Page>
	</App>
</mvc:View>
